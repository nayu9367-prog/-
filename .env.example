# Neon(Postgres) 데이터베이스 연결 문자열
# Vercel 프로젝트에 Neon 스토리지를 연결하면 자동으로 채워집니다.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 관리자 로그인 비밀번호 (bcrypt 해시). 평문을 여기에 넣지 마세요.
# 생성: npm run hash-password -- '실제비밀번호'
# 주의: bcrypt 해시는 $로 시작합니다. Next.js가 .env 파일의 $VAR를 변수로
# 치환하므로, 스크립트가 출력해주는 "\$"로 이스케이프된 값을 그대로 붙여넣으세요.
ADMIN_PASSWORD_HASH=change-me

# 학생들이 사이트 전체(관리자 페이지 제외)에 입장할 때 사용하는 공용 비밀번호의 bcrypt 해시
# 학번/이름 등 개인정보를 받지 않고, 외부인 접근만 막기 위한 용도입니다.
# 생성: npm run hash-password -- '실제비밀번호' (달러 기호 이스케이프 주의는 위와 동일)
SITE_PASSWORD_HASH=change-me

# 세션 쿠키 서명에 사용하는 임의의 긴 문자열 (예: `openssl rand -hex 32`로 생성)
SESSION_SECRET=change-me

# 학생 질문을 전달할 Google Apps Script 웹 앱 URL
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# 위 웹훅 요청이 실제로 이 서버에서 왔는지 Apps Script 쪽에서 검증할 수 있도록
# 요청 본문에 함께 실어 보내는 공유 비밀값 (예: `openssl rand -hex 24`로 생성).
# Apps Script의 doPost(e)에서 JSON.parse(e.postData.contents).secret 값을
# 이 값과 비교하도록 스크립트를 수정해야 합니다.
WEBHOOK_SECRET=change-me

# AI 사례 & 보건교육 튜터(/ai-tutor)에서 사용하는 Gemini API 키
# https://aistudio.google.com/app/apikey 에서 발급
GEMINI_API_KEY=

# (선택) 사용할 Gemini 모델. 기본값: gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash
